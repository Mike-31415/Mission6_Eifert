@model Movie

<div class="container mt-4">
    <h3 class="text-danger">Confirm Delete</h3>

    <p>Are you sure you want to delete:</p>

    <div class="card p-3 shadow-sm">
        <h5>@Model.Title (@Model.Year)</h5>
        <p><strong>Category:</strong> @(Model.Category?.CategoryName ?? "N/A")</p>
        <p><strong>Director:</strong> @Model.Director</p>
    </div>

    <form asp-action="Delete" method="post" class="mt-3">
        <input type="hidden" asp-for="MovieId" />
        <button type="submit" class="btn btn-danger">
            Yes, Delete
        </button>
        <a asp-action="MovieList" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>