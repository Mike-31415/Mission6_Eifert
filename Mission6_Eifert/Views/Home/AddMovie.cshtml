@{
    ViewData["Title"] = "AddMovie";
}
@model Movie
<h1>Add Movie</h1>
@* Form used to save data in the sqlite database *@
<form asp-action="AddMovie" method="post">
    <label asp-for="Title">Title:</label>
    <input asp-for="Title" type="text" required/>
    <br/>
    <br/>
    <label asp-for="CategoryId">Category</label>
    <select asp-for="CategoryId">
        @foreach (var category in ViewBag.Categories)
        {
            <option value="@category.CategoryId">@category.CategoryName</option>
        }
    </select>
    <br/>
    <br/>
    <label asp-for="Year">Year:</label>
    <input asp-for="Year" type="number" min="1888" max="@DateTime.Now.Year" required/>
    <br/>
    <br/>
    <label asp-for="Director">Director:</label>
    <input asp-for="Director" type="text"/>
    <br/>
    <br/>
    <label asp-for="Rating">Rating Field:</label>
    <select asp-for="Rating">
        <option value="" disabled selected>Select</option>
        <option value="G">G</option>
        <option value="NR">NR</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
        <option value="TV-14">TV-14</option>
        <option value="TV-G">TV-G</option>
        <option value="TV-PG">TV-PG</option>
        <option value="TV-Y7">TV-Y7</option>
        <option value="UR">UR</option>
    </select>
    <br/>
    <br/>
    <label asp-for="Edited">Edited:</label>
    <select asp-for="Edited" required>
        <option value="" disabled selected>Select</option>
        <option value="true">Yes</option>
        <option value="false">No</option>
    </select>
    <br/>
    <br/>
    <label asp-for="LentTo">Lent To:</label>
    <input asp-for="LentTo" type="text"/>
    <br/>
    <br/>
    <label asp-for="CopiedToPlex">Copied To Plex:</label>
    <select asp-for="CopiedToPlex" required>
        <option value="" disabled selected>Select</option>
        <option value="true">Yes</option>
        <option value="false">No</option>
    </select>
    <br/>
    <br/>
    <label asp-for="Notes">Notes:</label>
    <input asp-for="Notes" maxlength="25"/>
    <br/>
    <br/>
    <button type="submit">Submit</button>

</form>